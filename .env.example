# Copy this file to ".env" and fill in the real values. NEVER commit the real .env.
# The pipeline reads these from the environment; the Anthropic SDK auto-detects ANTHROPIC_API_KEY.

# --- Claude API (Anthropic Console) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if the key above is an ORG-level key (not scoped to a workspace).
# A workspace-scoped key needs neither this nor any header. Find the ID in the Console.
# ANTHROPIC_WORKSPACE_ID=wrkspc_xxxxxxxxxxxxxxxxxxxxxxxx

# --- (later) Business Central API (auth model TBD: OAuth S2S recommended, NavUserPassword = on-prem quick option) ---
# BC_BASE_URL=https://<bc-server>:<port>/<instance>/api/v2.0
# BC_COMPANY=CRONUS
# Option A — OAuth 2.0 Service-to-Service (Entra ID app registration; recommended, migration-proof):
# BC_TENANT_ID=
# BC_CLIENT_ID=
# BC_CLIENT_SECRET=
# Option B — NavUserPassword (on-prem only; service user + password over HTTPS):
# BC_USERNAME=<bc-service-user>
# BC_PASSWORD=<bc-service-user-password>
# BC web client base URL (BROWSER url, not the API url) — used by the review app to
# deep-link created orders/quotes back to BC. e.g. https://<server>/<instance>
# BC_WEB_URL=

# --- Microsoft Graph (read-only mailbox ingestion — src/ingestion/mailbox.js) ---
# App-only (client credentials). App registration needs application permission
# Mail.Read (admin-consented), scoped to just the shared mailbox via an
# Application Access Policy. See src/ingestion/README.md.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_MAILBOX=orders@yourdomain.com

# --- Order acknowledgement email (review app — src/step5-review/acknowledge.js) ---
# On Approve->create the app composes a brief receipt and, when ACK_SEND=1, SENDS it from
# GRAPH_MAILBOX. Requires the Graph app to also have the Mail.Send application permission
# (admin-consented) within the mailbox Application Access Policy.
# ACK_SEND=1                          # 1 = actually send; unset/0 = compose-only (dry-run, default)
# ACK_TEST_TO=navl@yourdomain.com     # redirect EVERY send here (testing); remove to email the PO's real buyer
# ACK_FROM_NAME=Buckeye Fasteners     # signature line in the body
