# Copy this file to ".env" and fill in the real values. NEVER commit the real .env.
# The pipeline reads these from the environment; the Anthropic SDK auto-detects ANTHROPIC_API_KEY.

# --- Claude API (Anthropic Console) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if the key above is an ORG-level key (not scoped to a workspace).
# A workspace-scoped key needs neither this nor any header. Find the ID in the Console.
# ANTHROPIC_WORKSPACE_ID=wrkspc_xxxxxxxxxxxxxxxxxxxxxxxx

# --- (later) Business Central OData API ---
# BC_BASE_URL=http://<bc-server>:<port>/<instance>/ODataV4
# BC_COMPANY=CRONUS
# BC_USERNAME=<bc-service-user>
# BC_WEB_SERVICE_ACCESS_KEY=<web-service-access-key>

# --- (later) Microsoft Graph (mailbox ingestion) ---
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# MAILBOX_ADDRESS=order@buckeyefasteners.com
